      "Bash(Rscript -e 'print\\(lintr::lint_package\\(\\)\\)')",
      "Bash(Rscript -e 'l <- lintr::lint_package\\(\\); cat\\(length\\(l\\), \"lints\\\\n\"\\); print\\(table\\(vapply\\(l, function\\(x\\) x$linter, \"\"\\)\\)\\)')",
      "Bash(Rscript -e 'l <- lintr::lint_package\\(\\); print\\(l[vapply\\(l, function\\(x\\) x$linter, \"\"\\)==\"object_usage_linter\"]\\)')",
      "Bash(git stash *)",
      "Bash(Rscript -e 'l <- lintr::lint_package\\(\\); print\\(table\\(vapply\\(l, function\\(x\\) x$linter, \"\"\\)\\)\\); print\\(l[vapply\\(l, function\\(x\\) x$linter, \"\"\\)==\"object_usage_linter\"]\\)')"
